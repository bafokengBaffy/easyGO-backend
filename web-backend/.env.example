# =============================
# EasyGo Web Backend - Environment Template
# =============================

# App
NODE_ENV=production
PORT=4000
API_VERSION=v1
APP_NAME=EasyGo Web Backend
APP_BASE_URL=https://api.easygo-app.com

# Security / Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# CORS (comma-separated)
CORS_ORIGINS=https://easygo-app.web.app,https://easygo-app.firebaseapp.com

# Database (PostgreSQL)
DB_DIALECT=postgres
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_SSL=false
DB_SYNC=false
DB_SYNC_ALTER=false

# Redis (recommended)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_UPLOAD_SIZE=5242880

# Cloudinary (required if using /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK
# Recommended in production on GCP: ADC / attached service account
FIREBASE_USE_ADC=true
FIREBASE_PROJECT_ID=easygols
FIREBASE_DATABASE_URL=https://easygols-default-rtdb.asia-southeast1.firebasedatabase.app

# Optional fallback methods (only if not using ADC)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@easygo.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Observability / Ops
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Service URLs (optional internal linking)
AI_SERVICE_URL=
FRONTEND_URL=https://easygo-app.web.app
