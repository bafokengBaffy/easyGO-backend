{
  "name": "easygo-web-backend",
  "version": "1.0.0",
  "description": "Web Backend API for EasyGo Platform",
  "main": "server.js",
  "scripts": {
    "build": "node -e \"console.log('No build step required for web-backend')\"",
    "start": "node server.js",
    "env:check": "node scripts/validate-env.js",
    "firebase:check": "node scripts/test-firebase-adc.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\"",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "cloudinary": "^1.41.3",
    "dotenv": "^16.3.1",
    "mysql2": "^3.11.3",
    "sequelize": "^6.35.0",
    "redis": "^4.6.11",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "axios": "^1.6.2",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1497.0",
    "stripe": "^14.8.0",
    "twilio": "^4.19.3",
    "@sendgrid/mail": "^7.7.0",
    "firebase-admin": "^11.11.1",
    "socket.io": "^4.5.4",
    "kafkajs": "^2.2.4",
    "amqplib": "^0.10.3",
    "@elastic/elasticsearch": "^8.11.0",
    "bull": "^4.11.5",
    "node-cron": "^3.0.3",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.1.0",
    "sequelize-cli": "^6.6.2",
    "faker": "^5.5.3",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
